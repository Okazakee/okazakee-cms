# Required - Get from Supabase project settings (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
DOMAIN_URL=http://localhost:3000

# Optional
# Set this on Vercel so CMS invite/reset links point to the correct site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
UMAMI_ENABLED=false
# Cache revalidation in seconds. Defaults:
# - production: 86400 (1 day)
# - preview/beta: 600 (10 minutes)
ISR_REVALIDATION=86400
NEXT_PUBLIC_LOCALES=en,it
NEXT_PUBLIC_DEFAULT_LOCALE=en
