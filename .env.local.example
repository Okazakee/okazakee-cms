# Standalone CMS environment (Okazakee/okazakee-cms)

# Required - Get from Supabase project settings (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
SUPABASE_SECRET_KEY=sb_secret_your-key

# Optional
# Public website origin (Home button in the CMS sidebar).
NEXT_PUBLIC_SITE_URL=https://okazakee.dev

# Canonical public origin of this CMS (OAuth callbacks, invite confirmation).
# Required in production and for invitations; set to the production CMS
# hostname on deployment. In production this is the
# ONLY origin used to build redirects — forwarded host headers are never
# trusted (development OAuth falls back to the request origin so localhost
# works). Invitation links always require this value: it must be a bare
# http(s) origin (no path/query) and must also be present in Supabase Auth →
# URL Configuration.
#
# Invitations redirect to ${CMS_PUBLIC_URL}/auth/confirm. Add that exact URL to
# the Supabase redirect allowlist, and configure a custom SMTP server: the
# built-in SMTP only reaches project team members at ~2 messages/hour, and a
# successful GoTrue response means "accepted", not "delivered".
CMS_PUBLIC_URL=https://cms.okazakee.dev

# Verbose CMS auth logging (also enabled automatically in development).
CMS_AUTH_DEBUG=false

# Application environment: production | staging | development (default:
# derived from NODE_ENV).
APP_ENV=development

# Public-site revalidation (required for production cross-app cache updates).
# URL of the public site's signed revalidation endpoint:
WEBSITE_REVALIDATION_URL=https://okazakee.dev/api/internal/content-revalidate
# Shared secret — MUST equal CONTENT_REVALIDATION_SECRET on the public site.
WEBSITE_REVALIDATION_SECRET=

NEXT_PUBLIC_LOCALES=en,it
NEXT_PUBLIC_DEFAULT_LOCALE=en

# --- Local development -------------------------------------------------------
# Local values live in the Vercel project's **Development** environment, so
# `vercel env pull` alone configures a checkout. A pull MERGES: keys the pulled
# environment defines are overwritten, keys that exist only locally are kept.
#
# Therefore the hazard is pulling a DIFFERENT environment. A
# `--environment=production` pull overwrites `WEBSITE_REVALIDATION_URL` with the
# deployed origin and drops `NEXT_PUBLIC_SUPABASE_DB_SCHEMA`; without that
# schema `src/config/shared.ts` falls back to `public`, and every local edit is
# written straight into production content. `.env.development.local` is the
# guard — Next.js loads it BEFORE `.env.local`, and `next build` / `next start`
# ignore it — with the local loop's two values:
#
#   # .env.development.local
#   NEXT_PUBLIC_SUPABASE_DB_SCHEMA=dev_staging
#   WEBSITE_REVALIDATION_URL=http://localhost:3000/api/internal/content-revalidate
#
# The second one must name the public site you are actually looking at — with
# the deployed origin a local edit purges production's cache, never the local
# `okazakee-ws`, which then keeps serving the pre-edit render.
#
# Auth is shared with the public site: inviting an email user from a local
# `dev_staging` session creates a real `auth.users` identity (the profile
# trigger is public-qualified) and asks Supabase to send real mail. The
# allowlist row is schema-scoped, so the invitee is authorized only in
# `dev_staging`. There is no CMS cleanup path for a non-dummy shared identity.

# --- Developing against a cloned schema (not production content) -------------
# Point both apps at a cloned schema (e.g. `dev_staging`) to exercise
# unpublished migrations without touching `public`. The schema must also be in
# the project's exposed-schema list (Dashboard -> Data API settings) or
# PostgREST answers "permission denied for schema".
# NEXT_PUBLIC_SUPABASE_DB_SCHEMA=dev_staging
