# Required - Get from Supabase project settings (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
DOMAIN_URL=http://localhost:3000

# Optional
# Canonical public origin of this CMS (OAuth callbacks, invite/recovery
# links). Set to the production CMS hostname on deployment; unset locally.
CMS_PUBLIC_URL=http://localhost:3000
# Verbose CMS auth logging (also enabled automatically in development)
CMS_AUTH_DEBUG=false
# Application environment: production | staging | development (default:
# derived from NODE_ENV). Controls cache defaults and publish-date
# enforcement on public reads.
APP_ENV=development
# Override public content cache lifetime in seconds.
ISR_REVALIDATION=86400
CONTENT_ENFORCE_PUBLISH_DATE=false
NEXT_PUBLIC_LOCALES=en,it
NEXT_PUBLIC_DEFAULT_LOCALE=en
