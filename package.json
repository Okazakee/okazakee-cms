{
  "name": "okazakee-cms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint .",
    "lint-fix": "biome check . --write --unsafe",
    "format": "biome format . --write",
    "test": "vitest run",
    "test:prod-infra": "vitest run src/testing/sql/productionMarkdownBackfillCas.test.ts src/testing/sql/productionContentStorageReadPolicy.test.ts src/utils/cms/prodStorageSetup.test.ts",
    "db:dev:check": "bun src/utils/cms/devMigrations.ts check",
    "storage:content:dev:setup": "bun src/utils/cms/storageSetup.ts",
    "storage:content:prod:setup": "bun src/utils/cms/prodStorageSetup.ts",
    "storage:content:prod:gc": "bun src/utils/cms/prodStorageGc.ts",
    "storage:content:prod:backup": "bun src/utils/cms/prodLegacyBodyBackup.ts",
    "storage:content:dev:backfill:plan": "bun src/utils/cms/backfillPlan.ts",
    "storage:content:dev:backfill:exec": "bun src/utils/cms/backfillExec.ts",
    "storage:content:dev:backfill:rollback": "bun src/utils/cms/backfillRollback.ts"
  },
  "dependencies": {
    "@img/sharp-libvips-linux-x64": "1.3.4",
    "@img/sharp-linux-x64": "0.35.5",
    "@sparticuz/chromium": "^153.0.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "blurkit": "^0.1.11",
    "lucide-react": "^1.61.0",
    "markdown-to-jsx": "^9.10.3",
    "next": "^16.4.3",
    "next-intl": "^4.14.9",
    "puppeteer-core": "^25.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@electric-sql/pglite": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^21.0.4",
    "postcss": "^8.5.31",
    "supabase": "^2.122.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "postcss-selector-parser": "^7.1.7"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version"
    ]
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": "24.x"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "@swc/core",
    "sharp"
  ]
}
